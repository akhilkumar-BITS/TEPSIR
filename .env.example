# Copy to .env and adjust. Never commit the real .env file.

ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Database (docker compose exposes PostgreSQL with pgvector on 5432)
POSTGRES_DSN=postgresql+asyncpg://tepsir:tepsir@localhost:5432/tepsir

# Redis caches query embeddings; search still works if it is down.
SEARCH_CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# Storage: "local" writes to LOCAL_STORAGE_DIR, "minio" uses the object store.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=var/storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=tepsir
MINIO_SECRET_KEY=tepsir-secret
MINIO_BUCKET=tepsir-documents

# Retrieval
# "dev" = deterministic hashing embedder (no model download, lower quality)
# "sentence-transformers" = real embeddings, install with: pip install '.[local-embeddings]'
EMBEDDING_PROVIDER=dev
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# Answer synthesis (optional). Without DEEPSEEK_API_KEY, /search/answer still
# returns retrieved passages with answer=null and a warning.
LLM_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=700
LLM_TEMPERATURE=0.1
LLM_MAX_CONTEXT_CHARS=12000
LLM_MAX_PASSAGE_CHARS=2000

# Bootstrap administrator, created on startup when both values are present.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin-password
